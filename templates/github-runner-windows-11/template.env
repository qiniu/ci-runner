# Build pins for the Windows 11 runner template. The Dockerfile copies this
# file into the template build for scripts/setup-template.ps1. Never add an
# environment-specific template ID here.
# TEMPLATE_NAME must equal name in qshell.sandbox.toml.
TEMPLATE_NAME=github-runner-windows-11
TEMPLATE_VERSION=20261021.1

# Must match RUNNER_VERSION in templates/common/actions-runner.env.
RUNNER_WIN_X64_VERSION=2.337.0
RUNNER_WIN_X64_ARCHIVE_SHA256=1150692afa94e71f872017e254ea55b6eece1eece3fe7e3a6d4c93d0a1b85cfc
RUNNER_WIN_X64_ARCHIVE_SIZE=103528051

GIT_VERSION=2.56.0.2
GIT_INSTALLER_URL=https://github.com/git-for-windows/git/releases/download/v2.56.0.windows.2/Git-2.56.0.2-64-bit.exe
GIT_INSTALLER_SHA256=52188f917b378f00c70ec136bcf090005f30d44fbc4eba0bce759cc6592d60f6
GIT_INSTALLER_SIZE=66763664

POWERSHELL_VERSION=7.6.7
POWERSHELL_MSI_URL=https://github.com/PowerShell/PowerShell/releases/download/v7.6.7/PowerShell-7.6.7-win-x64.msi
POWERSHELL_MSI_SHA256=ec575cef9ec56fcd905de0d5eeac9cb7f81a0a65abb87bb5cd0e87fdfe2b8cc0
POWERSHELL_MSI_SIZE=117514240
