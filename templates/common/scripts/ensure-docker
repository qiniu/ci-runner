#!/usr/bin/env bash
set -euo pipefail

docker_command="${DOCKER_BIN:-docker}"
dockerd_command="${DOCKERD_BIN:-dockerd}"
docker_socket="${DOCKER_SOCKET:-/var/run/docker.sock}"
docker_pid_file="${DOCKER_PID_FILE:-/var/run/docker.pid}"
docker_log_file="${DOCKER_LOG_FILE:-/tmp/dockerd.log}"
docker_proc_root="${DOCKER_PROC_ROOT:-/proc}"

if ! command -v "$docker_command" >/dev/null 2>&1 || ! command -v "$dockerd_command" >/dev/null 2>&1; then
  echo "Docker CLI or daemon is not installed" >&2
  exit 1
fi

run_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    sudo "$@"
  fi
}

docker_ready() {
  DOCKER_HOST="unix://$docker_socket" "$docker_command" info >/dev/null 2>&1
}

fix_docker_socket() {
  test -S "$docker_socket" || return 0
  run_root chgrp docker "$docker_socket"
  run_root chmod 0660 "$docker_socket"
}

fix_docker_socket
if docker_ready; then
  exit 0
fi

run_root mkdir -p "$(dirname "$docker_socket")" "$(dirname "$docker_pid_file")" /var/lib/docker
if [ -f "$docker_pid_file" ]; then
  daemon_pid="$(run_root cat "$docker_pid_file" 2>/dev/null || true)"
  daemon_name=""
  if [[ "$daemon_pid" =~ ^[1-9][0-9]*$ ]] && run_root kill -0 "$daemon_pid" 2>/dev/null; then
    daemon_name="$(run_root cat "$docker_proc_root/$daemon_pid/comm" 2>/dev/null || true)"
  fi
  if [ "$daemon_name" = dockerd ]; then
    run_root kill "$daemon_pid" 2>/dev/null || true
    for _ in $(seq 1 20); do
      if ! run_root kill -0 "$daemon_pid" 2>/dev/null; then
        break
      fi
      sleep 0.1
    done
    if run_root kill -0 "$daemon_pid" 2>/dev/null; then
      run_root kill -KILL "$daemon_pid" 2>/dev/null || true
    fi
  fi
  run_root rm -f "$docker_pid_file"
fi

run_root rm -f "$docker_socket"
run_root nohup "$dockerd_command" \
  --host="unix://$docker_socket" \
  --pidfile="$docker_pid_file" \
  >"$docker_log_file" 2>&1 &

for _ in $(seq 1 60); do
  fix_docker_socket
  if docker_ready; then
    docker_ready
    exit 0
  fi
  sleep 1
done

echo "dockerd did not become ready" >&2
tail -n 120 "$docker_log_file" >&2 || true
exit 1
