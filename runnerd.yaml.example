# Sensitive scalar values may use RUNNERD_ENC(v1:...) output from
# `runnerd --obfuscate-config-value`. This only hides plaintext from casual
# inspection; runnerd contains the key needed to reveal these values.

server:
  http_addr: ":25500"
  read_timeout_seconds: 15
  write_timeout_seconds: 60
  idle_timeout_seconds: 120

database:
  backend: sqlite
  # Relative sqlite paths are resolved from the directory containing runnerd.yaml.
  dsn: ./var/runnerd.db
  # Standalone Postgres example (does not migrate existing SQLite data):
  # backend: postgres
  # dsn: postgres://runner:secret@postgres.example:5432/runnerd?sslmode=require
  # Maintenance-window migration: use cmd/runnerd-migrate with a separate
  # protected Postgres config; see docs/sqlite-postgres-offline-migration.md.
  # Stop all writers first. Changing the DSN alone does not transfer existing data.
  # MySQL example:
  # backend: mysql
  # dsn: runner:secret@tcp(mysql.example:3306)/runnerd?parseTime=true&charset=utf8mb4&loc=UTC


auth:
  # Generate with: openssl rand -base64 32
  session_secret: change-me-to-a-random-session-secret
  # Generate with: openssl rand -base64 32
  encryption_key: change-me-to-a-separate-random-encryption-key
  session_ttl_hours: 12

sandbox:
  timeout_seconds: 3600
  create_timeout_seconds: 120
  stop_timeout_seconds: 30
  # Region catalog — label and api_url are exposed to the frontend via
  # GET /sandbox/regions so they are never hardcoded in the UI.
  regions:
    - id: us-south-1
      label: "United States · Dallas 1"
      sandbox_api_url: https://us-south-1-sandbox.qiniuapi.com
      s3_region: us-north-1
      s3_endpoint: https://internal-s3-las-us-north-1-dal.qiniucs.com
    - id: cn-yangzhou-1
      label: "China · Yangzhou 1"
      sandbox_api_url: https://cn-yangzhou-1-sandbox.qiniuapi.com
      s3_region: cn-east-1
      s3_endpoint: https://internal-s3-las-cn-east-1-yz.qiniucs.com

deploy:
  # Optional default template ID for Sandbox Deploy; users can choose a
  # public template, or an owned template with scoped credentials, in /deployments/new.
  # No selection rejects creation.
  template_id: ""
  work_root: /var/lib/runnerd/deployments
  # Maximum queued/running deployment attempts per account or organization scope.
  max_concurrent_per_scope: 3
  # Terminal records and their bounded events are retained for this long after cleanup.
  retention_hours: 168

github:
  webhook_secret: change-me
  # GitHub.com only. GitHub Enterprise Server is not currently supported.
  # Webhook requests use repository.full_name from GitHub; admitted repositories match enabled Runner Specs by labels.
  app:
    id: 123456
    # Optional. Enables the ordinary-user UI to link to the GitHub App installation flow.
    # Configure the GitHub App Setup URL as:
    #   http://127.0.0.1:25500/github-app/setup
    slug: your-github-app-slug
    # Optional. Leave empty to resolve the GitHub App installation dynamically per repository.
    # installation_id: 12345678
    # Relative paths are resolved from the directory containing runnerd.yaml.
    private_key_file: ./secrets/github-app.pem
  # Admin-console login uses the same GitHub App's OAuth settings.
  # Configure the GitHub App callback URL as:
  #   http://127.0.0.1:25500/auth/github/callback
  # or the public HTTPS URL used by your deployment.
  oauth:
    client_id: Iv1.your-github-app-client-id
    client_secret: your-github-app-client-secret
    # Optional when runnerd can infer the public URL from the request.
    redirect_url: https://runner.example.com/auth/github/callback
  # Optional repository allowlist. Empty means all repositories that installed the App are allowed.
  # allowed_repositories:
  #   - your-org/*
  #   - your-org/specific-repo
  # Auth alternatives: configure exactly one of app, token, or basic_auth.
  # token: ghp_your-token
  # basic_auth:
  #   username: your-username
  #   password: your-token-or-password

# S3-compatible Cache credentials (bucket, AK, SK) are configured by each user
# in account or GitHub installation Preferences; they are not stored in runnerd.yaml.
# On each sandbox start, runnerd mints a short-lived Qiniu IAM STS credential
# scoped to the user's cache prefix and injects it as AWS_* / RUNS_ON_S3_* env
# vars so runs-on/cache can upload and restore caches directly to the bucket.

cache:
  # STS federation token endpoint. The request path /sts/federation/token is appended.
  sts_endpoint: https://sts-ov.qiniuapi.com

worker:
  # Optional CI Runner limits keyed by GitHub owner login and owner/repository.
  # Omit a key (or use 0) for unlimited at that scope. These limits apply
  # across all Runner Specs and templates for the account/repository.
  account_concurrency_limits: {} # Example: {your-org: 20}
  repository_concurrency_limits: {} # Example: {your-org/project: 5}
  max_concurrent_runners: 100
  runner_idle_timeout_seconds: 300
  recovery_timeout_seconds: 120
  lease_ttl_seconds: 300
  retry_base_delay_seconds: 15
  retry_max_delay_seconds: 300
  retry_max_attempts: 5

# Runner specs, runner groups, and runner policies are managed through the
# admin API/UI. Create specs with meaningful names, for example "ubuntu-24-04",
# and set template_id to the Qiniu sandbox template that contains the GitHub runner image.
